# Copy to .env (dev) or /etc/default/lynkos (prod) and fill in real values.
# `install.sh` generates /etc/default/lynkos automatically on a Pi.

# Admin login. Hash with: uv run python -c 'import bcrypt; print(bcrypt.hashpw(b"yourpw", bcrypt.gensalt()).decode())'
LYNKOS_ADMIN_USERNAME=admin
LYNKOS_ADMIN_PASSWORD_HASH=$2b$12$...

# JWT signing key — REQUIRED to be a real secret in prod.
# Generate with: openssl rand -hex 32
LYNKOS_JWT_SECRET=generate-me-with-openssl-rand-hex-32

# JWT session lifetime.
LYNKOS_JWT_EXPIRE_MINUTES=720

# Interface names for this Pi.
LYNKOS_WAN_INTERFACE=eth0
LYNKOS_LAN_INTERFACE=wlan0

# Origins allowed to hit the API. Use your actual frontend origin(s)
# Example: ["http://10.42.0.1", "https://router.example.com"]
LYNKOS_CORS_ORIGINS=["*"]

# Dev-only: bypass shell-outs to nmcli / ip / pppd. Returns canned data.
# LYNKOS_MOCK_MODE=true

# Optional override for where runtime state is stored (snapshot, password hash).
# Defaults to <install_dir>/data/snapshot.json.
# LYNKOS_SNAPSHOT_PATH=/var/lib/lynkos/snapshot.json

# AI features are opt-in. Leave disabled unless you want the AI routes and UI.
# LYNKOS_AI_ENABLED=false
# LYNKOS_AI_PROVIDER=mock
# LYNKOS_AI_MODEL=gpt-4.1-mini
# LYNKOS_AI_API_KEY=
# LYNKOS_AI_MAX_INPUT_BYTES=32768
# LYNKOS_AI_ALLOW_ACTION_EXECUTION=false
